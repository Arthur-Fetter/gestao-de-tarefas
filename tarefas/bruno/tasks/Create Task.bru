meta {
  name: Create Task
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/tasks
  body: json
  auth: none
}

body:json {
  {
    "title": "My new task",
    "description": "Description of the task",
    "status": "pending",
    "assignedTo": "user-1"
  }
}

script:post-response {
  if (res.status === 201) {
    bru.setVar("taskId", res.body.id);
  }
}
